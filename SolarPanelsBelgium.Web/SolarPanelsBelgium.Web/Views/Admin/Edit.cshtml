@model SolarPanelsBelgium.Core.Entitites.SolarPanel

@{
    ViewData["Title"] = "Update Status";
}

<h1>Update Status</h1>

<h4>Solar Panel</h4>
<hr />
<div class="row">
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Area)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Area)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Wattage)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Wattage)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EfficiencyClass)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.EfficiencyClass)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.RoofDesign)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.RoofDesign)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.RoofOrientation)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.RoofOrientation)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PanelType)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PanelType)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DateSubmitted)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DateSubmitted)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Price)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Price)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
    </dl>
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Area" />
            <input type="hidden" asp-for="Wattage" />
            <input type="hidden" asp-for="EfficiencyClass" />
            <input type="hidden" asp-for="PanelType" />
            <input type="hidden" asp-for="RoofDesign" />
            <input type="hidden" asp-for="RoofOrientation" />
            <input type="hidden" asp-for="ApplicationUserId" />
            <div class="form-group">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" class="form-control" asp-items="ViewBag.Status">
                </select>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
